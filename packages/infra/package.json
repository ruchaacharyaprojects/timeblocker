{
  "name": "@timeblocker/infra",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK infrastructure for TimeBlocker: API Gateway + Lambdas, DynamoDB tables, EventBridge Scheduler, and Secrets Manager.",
  "type": "module",
  "bin": {
    "infra": "bin/infra.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "synth": "cdk synth",
    "test": "vitest run"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1164.0",
    "@aws-sdk/client-dynamodb": "^3.665.0",
