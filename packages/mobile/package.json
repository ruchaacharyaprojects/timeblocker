{
  "name": "@timeblocker/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "TimeBlocker Android app (bare React Native CLI, New Architecture + Hermes). Single user, on-device mode: no AWS, no backend, no paid services.",
  "scripts": {
    "android": "react-native run-android",
    "start": "react-native start",
    "prebundle": "npm --prefix ../scheduling-engine run build && npm --prefix ../usage-metrics run build && npm --prefix ../reminders run build && npm --prefix ../calendar-integration run build && npm --prefix ../flows run build && npm --prefix ../app-core run build",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@timeblocker/app-core": "file:../app-core",
    "@timeblocker/calendar-integration": "file:../calendar-integration",
    "@timeblocker/flows": "file:../flows",
    "@timeblocker/reminders": "file:../reminders",
    "@timeblocker/scheduling-engine": "file:../scheduling-engine",
    "@timeblocker/usage-metrics": "file:../usage-metrics",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-app-auth": "9.0.0",
    "react-native-background-fetch": "4.4.2",
    "react-native-keychain": "10.0.0",
    "react-native-safe-area-context": "5.11.0",
    "react-native-screens": "4.30.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-export-namespace-from": "7.29.7",
    "@babel/runtime": "7.29.10",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.0",
    "@types/react": "19.3.0",
    "jest": "29.7.0",
    "test-renderer": "1.3.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
